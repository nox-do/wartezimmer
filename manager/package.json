{
  "name": "@wartezimmer/manager",
  "private": true,
  "version": "6.1.6",
  "productName": "Wartezimmer Manager",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/patch-electron-macos-name.mjs && cross-env ELECTRON_RUN_AS_NODE= electron-vite dev",
    "build": "cross-env ELECTRON_RUN_AS_NODE= electron-vite build && node ../scripts/check-production-artifacts.mjs out",
    "prepare:packaged": "npm run --prefix .. build:server-shared && npm run --prefix ../setup build && node scripts/prepare-packaged-resources.mjs",
    "dist:mac": "npm run prepare:packaged && npm run build && node scripts/build-macos.mjs",
    "lint": "eslint \"src/**/*.{ts,svelte}\"",
    "smoke:electron": "npm run build && node scripts/smoke-electron.mjs",
    "test": "node --import tsx --test --test-reporter=dot src/**/*.test.ts && npm run test:packaging",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && svelte-check --tsconfig tsconfig.json",
    "dist:win": "npm run prepare:packaged && npm run build && node scripts/build-windows.mjs",
    "test:packaging": "node --test scripts/nsis-integrity.test.mjs scripts/check-packaged-files.test.mjs"
  },
  "dependencies": {
    "@wartezimmer/server-shared": "*"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^25.9.1",
    "cross-env": "^7.0.3",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "electron-vite": "^3.1.0",
    "svelte": "^5.35.5",
    "svelte-check": "^4.3.6",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "de.wartezimmer.manager",
    "productName": "Wartezimmer Manager",
    "asar": true,
    "directories": {
      "output": "../.tmp/build/manager"
    },
    "files": [
      "out/**/*",
      "package.json",
      "build/icons/icon.png",
      "!**/*.map",
      "!**/*.{ts,tsx,mts,cts,tsbuildinfo}",
      "!**/{test,tests,__tests__,benchmark,benchmarks}/**/*"
    ],
    "extraResources": [
      {
        "from": "build-resources/setup",
        "to": "setup",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build-resources/templates",
        "to": "templates",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../node_modules/electron/LICENSE",
        "to": "LICENSE.electron.txt"
      },
      {
        "from": "../node_modules/electron/dist/LICENSES.chromium.html",
        "to": "LICENSES.chromium.html"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "identity": null,
      "electronLanguages": [
        "de",
        "en"
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icons/icon.icns"
    },
    "dmg": {
      "artifactName": "WartezimmerManager-${version}-${arch}.${ext}",
      "background": "installer-assets/dmg-background.png",
      "iconSize": 80,
      "iconTextSize": 13,
      "contents": [
        {
          "x": 160,
          "y": 195,
          "type": "file"
        },
        {
          "x": 480,
          "y": 195,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WartezimmerManager-${version}-windows-${arch}-setup.${ext}",
      "executableName": "WartezimmerManager",
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "uninstallDisplayName": "Wartezimmer Manager",
      "include": "build/installer.nsh",
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico"
    }
  }
}
