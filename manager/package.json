{
  "name": "@praxis-flow/manager",
  "private": true,
  "version": "6.1.1",
  "productName": "Praxis Flow Manager",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/patch-electron-macos-name.mjs && cross-env ELECTRON_RUN_AS_NODE= electron-vite dev",
    "build": "cross-env ELECTRON_RUN_AS_NODE= electron-vite build",
    "prepare:packaged": "npm run --prefix .. build:server-shared && npm run --prefix ../setup build && node scripts/prepare-packaged-resources.mjs",
    "dist:mac": "npm run prepare:packaged && npm run build && electron-builder --mac dmg",
    "lint": "eslint \"src/**/*.{ts,svelte}\"",
    "smoke:electron": "npm run build && node scripts/smoke-electron.mjs",
    "test": "node --import tsx --test --test-reporter=dot src/**/*.test.ts && npm run test:packaging",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && svelte-check --tsconfig tsconfig.json",
    "dist:win": "npm run prepare:packaged && npm run build && node scripts/build-windows.mjs",
    "test:packaging": "node --test scripts/nsis-integrity.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@praxis-flow/server-shared": "*"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^25.9.1",
    "cross-env": "^7.0.3",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "electron-vite": "^3.1.0",
    "svelte": "^5.35.5",
    "svelte-check": "^4.3.6",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "de.praxisflow.manager",
    "productName": "Praxis Flow Manager",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-resources/setup",
        "to": "setup",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build-resources/templates",
        "to": "templates",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "identity": null,
      "electronLanguages": [
        "de",
        "en"
      ],
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "PraxisFlowManager-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PraxisFlowManager-${version}-windows-${arch}-setup.${ext}",
      "executableName": "PraxisFlowManager"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "uninstallDisplayName": "Praxis Flow Manager",
      "include": "build/installer.nsh"
    }
  }
}
