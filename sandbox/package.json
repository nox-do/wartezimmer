{
  "name": "@wartezimmer/sandbox",
  "private": true,
  "version": "6.1.4",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node ../scripts/build-typescript.mjs",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "node --import tsx --test --test-reporter=dot 'src/*.test.ts' 'src/routes/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@wartezimmer/server-shared": "*",
    "fastify": "^5.12.5"
  }
}
