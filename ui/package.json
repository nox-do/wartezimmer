{
  "name": "@praxis-flow/ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5180",
    "build": "vite build",
    "preview": "vite preview --port 5180",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "generate:openapi-types": "node ../scripts/generate-openapi-types.mjs",
    "typecheck": "npm run check",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.49.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.35.5",
    "svelte-check": "^4.3.6",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.4.0",
    "@dnd-kit/dom": "^0.4.0",
    "@dnd-kit/svelte": "^0.4.0",
    "@lucide/svelte": "^1.17.0",
    "@praxis-flow/domain": "*"
  }
}
