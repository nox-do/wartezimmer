{
  "name": "@wartezimmer/server-shared",
  "private": true,
  "version": "6.1.4",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./logger": {
      "types": "./dist/fastify-logger-options.d.ts",
      "import": "./dist/fastify-logger-options.js"
    },
    "./env-backup": {
      "types": "./dist/env-backup.d.ts",
      "import": "./dist/env-backup.js"
    },
    "./setup-api": {
      "types": "./dist/setup-api.d.ts",
      "import": "./dist/setup-api.js"
    },
    "./backup-path-labels": {
      "types": "./dist/backup-path-labels.d.ts",
      "import": "./dist/backup-path-labels.js"
    },
    "./tls-backup": {
      "types": "./dist/tls-backup.d.ts",
      "import": "./dist/tls-backup.js"
    },
    "./gateway-bridge": {
      "types": "./dist/gateway-bridge.d.ts",
      "import": "./dist/gateway-bridge.js"
    },
    "./device-address": {
      "types": "./dist/device-address.d.ts",
      "import": "./dist/device-address.js"
    },
    "./host-lifecycle-policy": {
      "types": "./dist/host-lifecycle-policy.d.ts",
      "import": "./dist/host-lifecycle-policy.js"
    },
    "./manager-status-projection": {
      "types": "./dist/manager-status-projection.d.ts",
      "import": "./dist/manager-status-projection.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-typescript.mjs",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "node --import tsx --test --test-reporter=dot 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "tsx": "^4.22.3"
  }
}
