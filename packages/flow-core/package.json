{
  "name": "@praxis-flow/flow-core",
  "version": "6.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "npm run build && node --import tsx --test --test-reporter=dot 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@praxis-flow/domain": "*"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
