# Generated at container start — Praxis Flow guest WLAN gateway.

GatewayInterface ${GATEWAY_INTERFACE}
GatewayAddress ${GATEWAY_IP}

# Remote Forward Authentication Service → app container portal UI
fasport ${APP_REMOTE_PORT}
faspath ${APP_PORTAL_PATH}
fasremoteip ${APP_REMOTE_IP}
fasremotefqdn ${PORTAL_FQDN}
faskey ${OPENNDS_FAS_KEY}
fas_secure_enabled 0

# Walled garden: portal UI + API reachable before full auth (HTTP LAN v1)
walledgarden port ${APP_REMOTE_PORT}
walledgarden fqdn_list "${PORTAL_FQDN}"

login_option_enabled 0
sessiontimeout 90
checkinterval 60

preauthidletimeout 30
authidletimeout 120
