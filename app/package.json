{
  "name": "@wartezimmer/app",
  "private": true,
  "version": "6.1.3",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node ../scripts/build-typescript.mjs && node -e \"const fs=require('node:fs');const src='src/shared/db/migrations';const dst='dist/shared/db/migrations';fs.mkdirSync(dst,{recursive:true});for(const file of fs.readdirSync(src)){if(file.endsWith('.sql'))fs.copyFileSync(src + '/' + file, dst + '/' + file);}\"",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "node ../scripts/run-node-tests.mjs --import tsx --root src --exclude src/routes/ops/ops-device-stream-routes.test.ts --exclude src/routes/ops/ops-stream-routes.test.ts --exclude src/routes/queue-stream-routes.test.ts",
    "test:network": "node --import tsx --test --test-reporter=dot src/routes/ops/ops-device-stream-routes.test.ts src/routes/ops/ops-stream-routes.test.ts src/routes/queue-stream-routes.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^10.1.6",
    "@wartezimmer/domain": "*",
    "@wartezimmer/flow-core": "*",
    "@wartezimmer/server-shared": "*",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.5",
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@types/node": "^25.9.3"
  }
}
