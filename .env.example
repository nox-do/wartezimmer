AUTH_ENABLED=true
SANDBOX_AUTH_ENABLED=true

AUTH_KEY_CAPTIVE=change-me-captive-key
# Staff login (MFA/Ops/Raum-Panel inside): Default PIN 0000 in der Datenbank.
# MFA/Panel-PIN: MFA → Betrieb; Ops-PIN: System → PIN & Sicherheit; MFA/Ops-Reset via Praxis Flow Manager → Wartung.
# STAFF_SESSION_TTL_MS=43200000
# Patient-Portal-Session (Upload/Formular): Standard 30 Minuten
# SESSION_TTL_MINUTES=30
# STAFF_SESSION_IDLE_TTL_MS=7200000
# Optional: erlaubt TV-Read-only ohne Pairing nur fuer exakt diese lokale Loopback-Origin.
# TV_LOCAL_ORIGIN=http://localhost:8080

# Docker container log rotation (json-file driver; app/sandbox stdout)
# DOCKER_LOG_MAX_SIZE=10m
# DOCKER_LOG_MAX_FILE=5

# Practice profile seed — written by host setup (`npm run setup`), imported into DB on first app start.
# Edit later under System → Praxis & Datenschutz (or /ops/setup wizard).
PRACTICE_DISPLAY_NAME=Hausarztpraxis Muster
# PRACTICE_ADDRESS=Musterstraße 1
# PRACTICE_POSTAL_CODE=12345
# PRACTICE_CITY=Musterstadt
# PRACTICE_PHONE=+49 123 456789
# PRACTICE_EMAIL=info@hausarztpraxis-muster.de
# PRACTICE_DPO=datenschutz@hausarztpraxis-muster.de

SANDBOX_INTERNAL_TOKEN=change-me-sandbox-internal-token
SANDBOX_BASE_URL=http://sandbox:8081
SANDBOX_SCAN_ENABLED=true
SANDBOX_SCAN_TIMEOUT_MS=15000
CLAMAV_DB_PATH=/var/lib/clamav
CLAMAV_MAX_SIGNATURE_AGE_HOURS=24
CLAMAV_AUTO_UPDATE_ON_START=true
# Optional: override UI static root (default: app/dist/ui-static or ui/build)
# UI_STATIC_ROOT=/app/app/dist/ui-static
BUSINESS_TZ=Europe/Berlin
EXPORT_BASE_PATH=/exports
# Host folders for Docker bind mounts (optional — defaults: ~/praxis-flow-exports, ~/praxis-flow-imports)
# Leave unset on macOS/Linux if Compose runs as your user. Override only for NAS/other drives.
# EXPORTS_HOST_PATH=/Users/your-user/praxis-flow-exports
# IMPORTS_HOST_PATH=/Users/your-user/praxis-flow-imports
# Windows: IMPORTS_HOST_PATH=C:/Users/your-user/praxis-flow-imports
# Written by host setup (`npm run setup`); LAN IP for device URLs and status probes
# SETUP_LAN_APP_IP=192.168.1.50
# Product URL for humans/devices (Terminal, TV, MFA, Ops, Portal). Default: http://<SETUP_LAN_APP_IP>:8080
# CANONICAL_BASE_URL=http://192.168.1.50:8080
CONTACT_LOOKUP_BASE_PATH=/imports
# Ops-UI: import folder + column mapping; container base path is /imports (see IMPORTS_HOST_PATH on host)

# Delivery (image-based compose profile) — uncomment only for image-based deploys, not local dev setup
# PRAXIS_FLOW_APP_IMAGE=ghcr.io/your-org/praxis-flow-app:v0.1.0
# PRAXIS_FLOW_SANDBOX_IMAGE=ghcr.io/your-org/praxis-flow-sandbox:v0.1.0
# PRAXIS_FLOW_GATEWAY_IMAGE=ghcr.io/your-org/praxis-flow-gateway:v0.1.0

# Guest WLAN gateway (optional — docker-compose.gateway*.yml, profile gateway, Linux host only)
# GATEWAY_INTERFACE=eth1
# GATEWAY_IP=192.168.88.1
# GATEWAY_DHCP_RANGE_START=192.168.88.50
# GATEWAY_DHCP_RANGE_END=192.168.88.250
# APP_PORTAL_URL=http://192.168.88.10:8080/portal
# APP_API_URL=http://127.0.0.1:8080
# APP_PORTAL_MENU_URL=http://192.168.88.10:8080/portal/menu
# PORTAL_FQDN=portal.praxis.local
# OPENNDS_FAS_KEY=change-me-opennds-fas-key
# GATEWAY_AUTH_BRIDGE_PORT=9100
# GATEWAY_AUTH_BRIDGE_BIND=0.0.0.0
# App → gateway bridge (Linux Docker default bridge IP; macOS often host.docker.internal)
# GATEWAY_AUTH_BRIDGE_URL=http://172.17.0.1:9100

# Optional outbox worker tuning
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_CLAIM_LEASE_MS=15000

